<Project>
  <!-- Shared by BloxCode (Windows), BloxCode.Linux and BloxCode.Core so every build reports the
       same version and update feed. -->
  <PropertyGroup>
    <Version>1.7.0</Version>
    <Product>Blox Code</Product>
    <Company>Blox Code</Company>
    <!-- Shown in the exe's Properties → Details, and checked when the exe is code-signed. -->
    <AssemblyTitle>Blox Code</AssemblyTitle>
    <Copyright>Copyright (c) 2026 Blox Code contributors</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Self-update feeds, tried in order and separated by ';'. Each is the address of a folder made
         by `node tools/release.js feed` (latest.json, latest.json.sig and the versioned files), on
         any static host. Empty disables self-updates. -->
    <UpdateFeeds>https://raw.githubusercontent.com/singularityscripts-collab/blox-code/main/updates/;https://gitlab.com/huginhohenriquerl/blox-code/-/raw/main/updates/</UpdateFeeds>
    <!-- The ECDSA P-256 key (base64 SubjectPublicKeyInfo) latest.json must be signed with; written by
         `node tools/release.js keygen`. The private half never enters the repository. -->
    <UpdatePublicKey>MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEnuHqDoEHf21g5XklHpp8aViS8KJIzonh77X4KQ4JOPKoewOY52+MX3Q3T/NaoAnlqVDkPMPaHRjzEc0jSAwZag==</UpdatePublicKey>
    <!-- Opened by the "Source code" buttons; empty hides them. -->
    <HomepageUrl>https://github.com/singularityscripts-collab/blox-code</HomepageUrl>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="UpdateFeeds" Value="$(UpdateFeeds)" />
    <AssemblyMetadata Include="UpdatePublicKey" Value="$(UpdatePublicKey)" />
    <AssemblyMetadata Include="HomepageUrl" Value="$(HomepageUrl)" />
  </ItemGroup>
</Project>
