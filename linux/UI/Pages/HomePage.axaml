<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:BloxCode.Linux.UI"
             x:Class="BloxCode.Linux.UI.Pages.HomePage">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="Layout" Margin="40,0,40,0" RowDefinitions="Auto,*,Auto">
            <!-- Things that need doing: Sober, the install, the link handler, NVIDIA -->
            <StackPanel x:Name="Banners" MaxWidth="640" Margin="0,8,0,0" />

            <StackPanel Grid.Row="1" MaxWidth="600" VerticalAlignment="Center" Margin="0,8,0,24">
                <!-- The game bar, like a desktop search box: paste a link and press Enter, or just Play -->
                <Border x:Name="Bar" Classes="searchbar">
                    <DockPanel>
                        <ui:IconView DockPanel.Dock="Left" Data="{StaticResource Icon.Search}" Width="17" Height="17" Margin="0,0,12,0"
                                     VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <Button x:Name="SendButton" DockPanel.Dock="Right" Classes="primary send" Width="44" Height="44" CornerRadius="22" Padding="0"
                                Click="OnSend" ToolTip.Tip="Play" AutomationProperties.Name="Play">
                            <ui:IconView Data="{StaticResource Icon.Play}" Filled="True" Width="14" Height="14" Margin="2,0,0,0" />
                        </Button>
                        <TextBox x:Name="Composer" Classes="bare" FontSize="15" Margin="0,0,8,0" Watermark="Paste a game link"
                                 AutomationProperties.Name="Game link"
                                 KeyDown="OnComposerKeyDown" TextChanged="OnComposerChanged" />
                    </DockPanel>
                </Border>
                <TextBlock x:Name="ComposerHint" Classes="mono" HorizontalAlignment="Center" Margin="0,14,0,0"
                           Text="Enter to launch · empty opens Roblox" />
            </StackPanel>

            <!-- Sober's state and its settings, out of the way -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,16" Spacing="6">
                <TextBlock x:Name="StatusLine" Classes="mono" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Classes="ghost" FontSize="12.5" HorizontalAlignment="Center" Click="OnSober" Content="Sober settings" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
