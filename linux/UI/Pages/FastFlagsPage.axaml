<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:BloxCode.Linux.UI"
             x:Class="BloxCode.Linux.UI.Pages.FastFlagsPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" Margin="40,8,40,40">
            <TextBlock Text="Fast Flags" Classes="h1" />
            <TextBlock Classes="muted" Margin="0,0,0,20"
                       Text="Fast Flags tweak how Roblox renders. Blox Code writes them into Sober's config.json as soon as you change them, so they apply however you start Roblox. Roblox only honours flags on its allow-list; the presets here use nothing else." />

            <!-- One-click graphics presets, built only from allow-listed flags -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Text="Graphics preset" Classes="h2" />
                    <TextBlock Classes="muted" Margin="0,3,0,10" Text="Quality, textures, grass and detail in one go." />
                    <Border Classes="segmented">
                        <StackPanel x:Name="GraphicsSegments" Orientation="Horizontal" />
                    </Border>
                    <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{StaticResource Radius.Medium}" Padding="12,9" Margin="0,12,0,0">
                        <TextBlock x:Name="GraphicsHint" Classes="muted" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </Border>

                    <!-- Suggestion from the graphics card -->
                    <Border x:Name="RecommendRow" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="{StaticResource Radius.Medium}" Padding="12,8" Margin="0,8,0,0" IsVisible="False">
                        <DockPanel>
                            <Button x:Name="RecommendButton" DockPanel.Dock="Right" Classes="primary" Padding="12,5" Content="Use it" Click="OnUseRecommended" />
                            <TextBlock x:Name="RecommendText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Brush.Text}" Margin="0,0,10,0" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="4">
                    <DockPanel>
                        <CheckBox x:Name="PauseLighting" DockPanel.Dock="Right" Theme="{StaticResource Toggle}" IsCheckedChanged="OnExtraChanged" />
                        <StackPanel>
                            <TextBlock Text="Pause lighting updates" Classes="h2" />
                            <TextBlock Classes="muted" Margin="0,2,0,0" Text="More FPS on weak graphics cards. Light and shadows from moving things stop updating." />
                        </StackPanel>
                    </DockPanel>
                    <Border Classes="divider" />
                    <DockPanel>
                        <CheckBox x:Name="PlainSky" DockPanel.Dock="Right" Theme="{StaticResource Toggle}" IsCheckedChanged="OnExtraChanged" />
                        <StackPanel>
                            <TextBlock Text="Plain gray sky" Classes="h2" />
                            <TextBlock Classes="muted" Margin="0,2,0,0" Text="Skips drawing the skybox for a few extra frames." />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel>
                    <TextBlock Text="Anti-aliasing (MSAA)" Classes="h2" />
                    <TextBlock Classes="muted" Margin="0,3,0,10" Text="Smooths jagged edges. Higher costs more GPU time." />
                    <Border Classes="segmented">
                        <StackPanel x:Name="MsaaSegments" Orientation="Horizontal" />
                    </Border>

                    <Border Classes="divider" />

                    <TextBlock Text="Texture quality" Classes="h2" />
                    <TextBlock Classes="muted" Margin="0,3,0,10" Text="Forces a texture level instead of Roblox's automatic choice. Lower helps on GPUs with 2 GB of memory or less." />
                    <Border Classes="segmented">
                        <StackPanel x:Name="TextureSegments" Orientation="Horizontal" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Entry to the editor, like Bloxstrap's "Fast Flag Editor" button -->
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Click="OnOpenEditor" CornerRadius="14">
                <Border Classes="card" Margin="0">
                    <DockPanel>
                        <ui:IconView DockPanel.Dock="Right" Data="{StaticResource Icon.Back}" Width="16" Height="16" RenderTransform="rotate(180deg)" />
                        <StackPanel>
                            <TextBlock Text="Fast Flag Editor" Classes="h2" />
                            <TextBlock x:Name="EditorSummary" Classes="muted" Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
