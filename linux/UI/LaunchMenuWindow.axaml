<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BloxCode.Linux.UI"
        x:Class="BloxCode.Linux.UI.LaunchMenuWindow"
        Title="Blox Code" Width="420" SizeToContent="Height" CanResize="False"
        SystemDecorations="None" WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <!-- Opened when Blox Code starts without arguments, like Bloxstrap's launch menu:
         play right away, or go to the settings. -->
    <Border Classes="frame">
        <Panel x:Name="Root">
            <Button Classes="caption close" Click="OnClose" ToolTip.Tip="Close" HorizontalAlignment="Right" VerticalAlignment="Top">
                <ui:IconView Data="{StaticResource Icon.Close}" Width="12" Height="12" />
            </Button>

            <StackPanel x:Name="Body" Margin="32,44,32,22">
                <ui:BitMascot x:Name="Mascot" Unit="3" HorizontalAlignment="Center"
                              Body="{DynamicResource Brush.Mascot}" Eye="{DynamicResource Brush.MascotEye}" />
                <TextBlock HorizontalAlignment="Center" Margin="0,16,0,0" FontFamily="{StaticResource Font.Display}" FontWeight="SemiBold" FontSize="22"
                           Foreground="{DynamicResource Brush.Text}">
                    <Run Text="blox code" /><Run Text="_" Foreground="{DynamicResource Brush.Accent}" />
                </TextBlock>
                <TextBlock x:Name="VersionText" Classes="muted" HorizontalAlignment="Center" Margin="0,4,0,26" />

                <Button x:Name="LaunchButton" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="18,14" Click="OnLaunch" IsDefault="True">
                    <DockPanel>
                        <ui:IconView DockPanel.Dock="Left" Data="{StaticResource Icon.Play}" Filled="True" Width="16" Height="16" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <ui:IconView DockPanel.Dock="Right" Data="{StaticResource Icon.Back}" Width="12" Height="12" RenderTransform="rotate(180deg)" Opacity="0.7" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Launch Roblox" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="LaunchSummary" FontSize="12" FontWeight="Normal" Opacity="0.8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </Button>

                <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="18,14" Margin="0,10,0,0" Click="OnConfigure">
                    <DockPanel>
                        <ui:IconView DockPanel.Dock="Left" Data="{StaticResource Icon.Sliders}" Width="16" Height="16" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <ui:IconView DockPanel.Dock="Right" Data="{StaticResource Icon.Back}" Width="12" Height="12" RenderTransform="rotate(180deg)"
                                     Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Configure Blox Code" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Fast Flags, mods, Sober and more" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0" Spacing="4">
                    <Button Classes="ghost" FontSize="12.5" Padding="10,5" Content="What's new" Click="OnWhatsNew" />
                    <Button x:Name="SourceButton" Classes="ghost" FontSize="12.5" Padding="10,5" Content="Source code" Click="OnSource" />
                </StackPanel>
            </StackPanel>
        </Panel>
    </Border>
</Window>
