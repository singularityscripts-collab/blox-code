<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BloxCode.Linux.UI"
        x:Class="BloxCode.Linux.UI.MainWindow"
        Title="Blox Code" Width="1040" Height="680" MinWidth="820" MinHeight="540"
        SystemDecorations="None" WindowStartupLocation="CenterScreen">
    <Border Classes="frame" x:Name="Frame">
        <Panel x:Name="Root">
            <Grid RowDefinitions="52,*,Auto">
                <!-- ===== Top bar: brand, page tabs, window buttons (the empty space drags the window) ===== -->
                <Border x:Name="TitleBar" Background="Transparent" />
                <DockPanel>
                    <StackPanel x:Name="Brand" DockPanel.Dock="Left" Orientation="Horizontal" Margin="22,0,26,0" VerticalAlignment="Center" Background="Transparent">
                        <ui:BitMascot x:Name="BrandMascot" Unit="1.2" VerticalAlignment="Center" Margin="0,0,10,0"
                                      Body="{DynamicResource Brush.Mascot}" Eye="{DynamicResource Brush.MascotEye}" />
                        <TextBlock FontFamily="{StaticResource Font.Mono}" FontWeight="Medium" FontSize="14" VerticalAlignment="Center"><Run Text="blox code" /><Run Text="_" Foreground="{DynamicResource Brush.Accent}" /></TextBlock>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Classes="caption" Click="OnMinimize" ToolTip.Tip="Minimize">
                            <ui:IconView Data="{StaticResource Icon.Minimize}" Width="14" Height="14" StrokeThickness="1.3" />
                        </Button>
                        <Button x:Name="MaximizeButton" Classes="caption" Click="OnMaximize" ToolTip.Tip="Maximize">
                            <ui:IconView x:Name="MaximizeIcon" Data="{StaticResource Icon.Maximize}" Width="14" Height="14" StrokeThickness="1.3" />
                        </Button>
                        <Button Classes="caption close" Click="OnClose" ToolTip.Tip="Close">
                            <ui:IconView Data="{StaticResource Icon.Close}" Width="14" Height="14" StrokeThickness="1.3" />
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="Nav" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <RadioButton x:Name="NavHome" Theme="{StaticResource NavTab}" Tag="Home" IsCheckedChanged="OnNavigate" Content="Home" />
                        <RadioButton Theme="{StaticResource NavTab}" Tag="FastFlags" IsCheckedChanged="OnNavigate" Content="Flags" />
                        <RadioButton Theme="{StaticResource NavTab}" Tag="Mods" IsCheckedChanged="OnNavigate" Content="Mods" />
                        <RadioButton Theme="{StaticResource NavTab}" Tag="Sober" IsCheckedChanged="OnNavigate" Content="Sober" />
                        <RadioButton Theme="{StaticResource NavTab}" Tag="Appearance" IsCheckedChanged="OnNavigate" Content="Look" />
                        <RadioButton Theme="{StaticResource NavTab}" Tag="Behaviour" IsCheckedChanged="OnNavigate" Content="Settings" />
                        <RadioButton Theme="{StaticResource NavTab}" Tag="About" IsCheckedChanged="OnNavigate" Content="About" />
                    </StackPanel>
                </DockPanel>

                <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False" />

                <!-- ===== Status line: Blox Code's install state, then its version ===== -->
                <DockPanel Grid.Row="2" Margin="24,8,24,12">
                    <TextBlock x:Name="FooterVersion" DockPanel.Dock="Right" Classes="mono" FontSize="11.5" VerticalAlignment="Center" Margin="16,0,0,0" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="FooterDot" Width="6" Height="6" Margin="0,0,9,0" VerticalAlignment="Center" Fill="{DynamicResource Brush.Success}" />
                        <TextBlock x:Name="FooterTitle" Text="Blox Code" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                        <TextBlock x:Name="FooterSubtitle" Classes="mono" FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Panel>
    </Border>
</Window>
