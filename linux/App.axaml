<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BloxCode.Linux.App"
             Name="Blox Code"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Blox Code "Daylight": cool blueprint paper, ink-navy text, deep mint accent (same values as the WPF app) -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Brush.Bg" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="Brush.Sidebar" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#F3F3F5" />
                    <SolidColorBrush x:Key="Brush.Hover" Color="#EFEFF1" />
                    <SolidColorBrush x:Key="Brush.Selected" Color="#E6E6E9" />
                    <SolidColorBrush x:Key="Brush.Border" Color="#E7E7EA" />
                    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#D5D5DA" />
                    <SolidColorBrush x:Key="Brush.Text" Color="#18181B" />
                    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#3F3F46" />
                    <SolidColorBrush x:Key="Brush.TextMuted" Color="#71717A" />
                    <SolidColorBrush x:Key="Brush.Accent" Color="#077257" />
                    <SolidColorBrush x:Key="Brush.AccentHover" Color="#055C46" />
                    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#E2F3ED" />
                    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="Brush.Danger" Color="#C53A46" />
                    <SolidColorBrush x:Key="Brush.Success" Color="#2F7D4F" />
                    <SolidColorBrush x:Key="Brush.Warning" Color="#9A6A12" />
                    <SolidColorBrush x:Key="Brush.Mascot" Color="#D77757" />
                    <SolidColorBrush x:Key="Brush.MascotEye" Color="#141413" />
                    <SolidColorBrush x:Key="Brush.NavSelected" Color="#EDEDF0" />
                    <SolidColorBrush x:Key="Brush.CardFill" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="Brush.CardBorder" Color="#E7E7EA" />
                    <SolidColorBrush x:Key="Brush.AccentFill" Color="#077257" />
                    <SolidColorBrush x:Key="Brush.Glow" Color="Transparent" />

                    <!-- Fluent controls (text boxes, scroll bars, tooltips) pick these up -->
                    <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#D5D5DA" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#BDBDC4" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#077257" />
                    <SolidColorBrush x:Key="TextControlForeground" Color="#18181B" />
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#18181B" />
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#18181B" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#71717A" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#71717A" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#71717A" />
                    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#9FDCC7" />
                    <SolidColorBrush x:Key="ToolTipBackground" Color="#18181B" />
                    <SolidColorBrush x:Key="ToolTipForeground" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#18181B" />
                    <SolidColorBrush x:Key="ListBoxItemBackgroundPointerOver" Color="#F3F3F5" />
                    <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="#D3F0E6" />
                    <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="#C2E9DB" />
                    <SolidColorBrush x:Key="ListBoxItemBackgroundPressed" Color="#EFEFF1" />
                    <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressed" Color="#C2E9DB" />
                </ResourceDictionary>

                <!-- Blox Code "Midnight": deep navy like Bit's terminal screen, with a bright mint cursor accent -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Brush.Bg" Color="#111214" />
                    <SolidColorBrush x:Key="Brush.Sidebar" Color="#111214" />
                    <SolidColorBrush x:Key="Brush.Surface" Color="#18191C" />
                    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#1C1D21" />
                    <SolidColorBrush x:Key="Brush.Hover" Color="#202125" />
                    <SolidColorBrush x:Key="Brush.Selected" Color="#27282D" />
                    <SolidColorBrush x:Key="Brush.Border" Color="#24252A" />
                    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#313238" />
                    <SolidColorBrush x:Key="Brush.Text" Color="#EDEEF0" />
                    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#B6B9C0" />
                    <SolidColorBrush x:Key="Brush.TextMuted" Color="#7D818B" />
                    <SolidColorBrush x:Key="Brush.Accent" Color="#3EE6B0" />
                    <SolidColorBrush x:Key="Brush.AccentHover" Color="#62EDC1" />
                    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#14302A" />
                    <SolidColorBrush x:Key="Brush.OnAccent" Color="#04261C" />
                    <SolidColorBrush x:Key="Brush.Danger" Color="#FF7A85" />
                    <SolidColorBrush x:Key="Brush.Success" Color="#5FD99A" />
                    <SolidColorBrush x:Key="Brush.Warning" Color="#F2C14E" />
                    <SolidColorBrush x:Key="Brush.Mascot" Color="#D77757" />
                    <SolidColorBrush x:Key="Brush.MascotEye" Color="#141413" />
                    <SolidColorBrush x:Key="Brush.NavSelected" Color="#1E1F23" />
                    <SolidColorBrush x:Key="Brush.CardFill" Color="#16171A" />
                    <SolidColorBrush x:Key="Brush.CardBorder" Color="#24252A" />
                    <SolidColorBrush x:Key="Brush.AccentFill" Color="#3EE6B0" />
                    <SolidColorBrush x:Key="Brush.Glow" Color="Transparent" />

                    <SolidColorBrush x:Key="TextControlBackground" Color="#18191C" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#18191C" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#18191C" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#313238" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#43454D" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#3EE6B0" />
                    <SolidColorBrush x:Key="TextControlForeground" Color="#EDEEF0" />
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#EDEEF0" />
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#EDEEF0" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#7D818B" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#7D818B" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#7D818B" />
                    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#1F6B57" />
                    <SolidColorBrush x:Key="ToolTipBackground" Color="#EDEEF0" />
                    <SolidColorBrush x:Key="ToolTipForeground" Color="#111214" />
                    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#EDEEF0" />
                    <SolidColorBrush x:Key="ListBoxItemBackgroundPointerOver" Color="#202125" />
                    <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="#14302A" />
                    <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="#184640" />
                    <SolidColorBrush x:Key="ListBoxItemBackgroundPressed" Color="#27282D" />
                    <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressed" Color="#184640" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Color x:Key="SystemAccentColor">#1FB88A</Color>
            <Color x:Key="SystemAccentColorDark1">#13A079</Color>
            <Color x:Key="SystemAccentColorDark2">#077257</Color>
            <Color x:Key="SystemAccentColorDark3">#055C46</Color>
            <Color x:Key="SystemAccentColorLight1">#3EE6B0</Color>
            <Color x:Key="SystemAccentColorLight2">#6CEFC5</Color>
            <Color x:Key="SystemAccentColorLight3">#9FF5D9</Color>

            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://BloxCode/UI/Themes/Controls.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://BloxCode/UI/Themes/Styles.axaml" />
    </Application.Styles>
</Application>
