<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BloxCode.Linux.App"
             Name="Blox Code"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Blox Code "Daylight": cool blueprint paper, ink-navy text, deep mint accent (same values as the WPF app) -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Brush.Bg" Color="#F4F6FB" />
                    <SolidColorBrush x:Key="Brush.Sidebar" Color="#EAEEF6" />
                    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#EDF0F7" />
                    <SolidColorBrush x:Key="Brush.Hover" Color="#E1E6F0" />
                    <SolidColorBrush x:Key="Brush.Selected" Color="#D6DDEB" />
                    <SolidColorBrush x:Key="Brush.Border" Color="#DADFEA" />
                    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#C2CADB" />
                    <SolidColorBrush x:Key="Brush.Text" Color="#0F1320" />
                    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#343B4E" />
                    <SolidColorBrush x:Key="Brush.TextMuted" Color="#646D84" />
                    <SolidColorBrush x:Key="Brush.Accent" Color="#077257" />
                    <SolidColorBrush x:Key="Brush.AccentHover" Color="#055C46" />
                    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#D3F0E6" />
                    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="Brush.Danger" Color="#C53A46" />
                    <SolidColorBrush x:Key="Brush.Success" Color="#2F7D4F" />
                    <SolidColorBrush x:Key="Brush.Warning" Color="#9A6A12" />
                    <SolidColorBrush x:Key="Brush.Mascot" Color="#D77757" />
                    <SolidColorBrush x:Key="Brush.MascotEye" Color="#141413" />
                    <SolidColorBrush x:Key="Brush.NavSelected" Color="#DCEFE8" />
                    <LinearGradientBrush x:Key="Brush.CardFill" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#FFFFFF" Offset="0" />
                        <GradientStop Color="#FAFBFE" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="Brush.CardBorder" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#E4E8F0" Offset="0" />
                        <GradientStop Color="#CFD6E3" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="Brush.AccentFill" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#0B8565" Offset="0" />
                        <GradientStop Color="#066A51" Offset="1" />
                    </LinearGradientBrush>
                    <RadialGradientBrush x:Key="Brush.Glow" Center="85%,0%" GradientOrigin="85%,0%" RadiusX="75%" RadiusY="90%">
                        <GradientStop Color="#2610B981" Offset="0" />
                        <GradientStop Color="#0A6C7CFF" Offset="0.45" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </RadialGradientBrush>

                    <!-- Fluent controls (text boxes, scroll bars, tooltips) pick these up -->
                    <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#C2CADB" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#A8B2C7" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#077257" />
                    <SolidColorBrush x:Key="TextControlForeground" Color="#0F1320" />
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#0F1320" />
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#0F1320" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#646D84" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#646D84" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#646D84" />
                    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#9FDCC7" />
                    <SolidColorBrush x:Key="ToolTipBackground" Color="#0F1320" />
                    <SolidColorBrush x:Key="ToolTipForeground" Color="#F4F6FB" />
                    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#0F1320" />
                    <SolidColorBrush x:Key="ListBoxItemBackgroundPointerOver" Color="#EDF0F7" />
                    <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="#D3F0E6" />
                    <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="#C2E9DB" />
                    <SolidColorBrush x:Key="ListBoxItemBackgroundPressed" Color="#E1E6F0" />
                    <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressed" Color="#C2E9DB" />
                </ResourceDictionary>

                <!-- Blox Code "Midnight": deep navy like Bit's terminal screen, with a bright mint cursor accent -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Brush.Bg" Color="#0F131D" />
                    <SolidColorBrush x:Key="Brush.Sidebar" Color="#0A0D15" />
                    <SolidColorBrush x:Key="Brush.Surface" Color="#181D2B" />
                    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#131826" />
                    <SolidColorBrush x:Key="Brush.Hover" Color="#212839" />
                    <SolidColorBrush x:Key="Brush.Selected" Color="#283149" />
                    <SolidColorBrush x:Key="Brush.Border" Color="#232A3C" />
                    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#343D55" />
                    <SolidColorBrush x:Key="Brush.Text" Color="#ECF0FA" />
                    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#C3CADB" />
                    <SolidColorBrush x:Key="Brush.TextMuted" Color="#8A93AB" />
                    <SolidColorBrush x:Key="Brush.Accent" Color="#3EE6B0" />
                    <SolidColorBrush x:Key="Brush.AccentHover" Color="#6CEFC5" />
                    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#133A35" />
                    <SolidColorBrush x:Key="Brush.OnAccent" Color="#052A20" />
                    <SolidColorBrush x:Key="Brush.Danger" Color="#FF7A85" />
                    <SolidColorBrush x:Key="Brush.Success" Color="#5FD99A" />
                    <SolidColorBrush x:Key="Brush.Warning" Color="#F2C14E" />
                    <SolidColorBrush x:Key="Brush.Mascot" Color="#D77757" />
                    <SolidColorBrush x:Key="Brush.MascotEye" Color="#141413" />
                    <SolidColorBrush x:Key="Brush.NavSelected" Color="#16282C" />
                    <LinearGradientBrush x:Key="Brush.CardFill" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#1B2131" Offset="0" />
                        <GradientStop Color="#161B28" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="Brush.CardBorder" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#36405A" Offset="0" />
                        <GradientStop Color="#1F2535" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="Brush.AccentFill" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#55F0C2" Offset="0" />
                        <GradientStop Color="#2CD39F" Offset="1" />
                    </LinearGradientBrush>
                    <RadialGradientBrush x:Key="Brush.Glow" Center="85%,0%" GradientOrigin="85%,0%" RadiusX="75%" RadiusY="90%">
                        <GradientStop Color="#223EE6B0" Offset="0" />
                        <GradientStop Color="#0C6C7CFF" Offset="0.45" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>

                    <SolidColorBrush x:Key="TextControlBackground" Color="#181D2B" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#181D2B" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#181D2B" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#343D55" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#48536F" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#3EE6B0" />
                    <SolidColorBrush x:Key="TextControlForeground" Color="#ECF0FA" />
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#ECF0FA" />
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#ECF0FA" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#8A93AB" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#8A93AB" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#8A93AB" />
                    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#1F6B57" />
                    <SolidColorBrush x:Key="ToolTipBackground" Color="#ECF0FA" />
                    <SolidColorBrush x:Key="ToolTipForeground" Color="#111520" />
                    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#ECF0FA" />
                    <SolidColorBrush x:Key="ListBoxItemBackgroundPointerOver" Color="#212839" />
                    <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="#133A35" />
                    <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="#184640" />
                    <SolidColorBrush x:Key="ListBoxItemBackgroundPressed" Color="#283149" />
                    <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressed" Color="#184640" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Color x:Key="SystemAccentColor">#1FB88A</Color>
            <Color x:Key="SystemAccentColorDark1">#13A079</Color>
            <Color x:Key="SystemAccentColorDark2">#077257</Color>
            <Color x:Key="SystemAccentColorDark3">#055C46</Color>
            <Color x:Key="SystemAccentColorLight1">#3EE6B0</Color>
            <Color x:Key="SystemAccentColorLight2">#6CEFC5</Color>
            <Color x:Key="SystemAccentColorLight3">#9FF5D9</Color>

            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://BloxCode/UI/Themes/Controls.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://BloxCode/UI/Themes/Styles.axaml" />
    </Application.Styles>
</Application>
