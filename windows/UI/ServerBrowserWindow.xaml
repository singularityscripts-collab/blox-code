<Window x:Class="BloxCode.UI.ServerBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Window.Claude}"
        Title="Choose a server" Width="560" Height="600" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0,0,0,1" ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border Padding="24,20,24,18" MouseLeftButtonDown="OnDrag" Background="{DynamicResource Brush.Bg}">
        <DockPanel>
            <!-- Title, game, sorting -->
            <StackPanel DockPanel.Dock="Top">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Caption}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close" Height="32" />
                    <TextBlock Text="Choose a server" Style="{StaticResource Text.H1}" FontSize="22" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="GameText" Style="{StaticResource Text.Muted}" Margin="0,2,0,14" TextTrimming="CharacterEllipsis" />
                <DockPanel Margin="0,0,0,10">
                    <Border DockPanel.Dock="Left" Style="{StaticResource Segmented}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="SortFull" Style="{StaticResource Segment}" GroupName="ServerSort" Content="Most players" IsChecked="True" Checked="OnSortChanged" />
                            <RadioButton x:Name="SortEmpty" Style="{StaticResource Segment}" GroupName="ServerSort" Content="Fewest players" Checked="OnSortChanged" />
                            <RadioButton x:Name="SortPing" Style="{StaticResource Segment}" GroupName="ServerSort" Content="Lowest ping" Checked="OnSortChanged" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="CountText" Style="{StaticResource Text.Mono}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>

            <!-- Footer: more servers, and what the numbers mean -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Button x:Name="MoreButton" DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Load more" Click="OnMore" Visibility="Collapsed" />
                <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                           Text="Ping is the server's own, an average for its players. Where a server is shows once you join." />
            </DockPanel>

            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ServerList" />
                </ScrollViewer>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button x:Name="RetryButton" Style="{StaticResource Button.Secondary}" Content="Try again" Margin="0,12,0,0" HorizontalAlignment="Center"
                            Visibility="Collapsed" Click="OnRetry" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
