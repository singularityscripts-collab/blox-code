<Window x:Class="BloxCode.UI.LaunchMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BloxCode.UI"
        Style="{StaticResource Window.Claude}"
        Title="Blox Code" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="0,0,0,1" ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Opened when Blox Code starts without arguments, like Bloxstrap's launch menu:
         play right away, or go to the settings. -->
    <Grid Background="{DynamicResource Brush.Bg}">
        <Button Style="{StaticResource Button.CaptionClose}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close"
                HorizontalAlignment="Right" VerticalAlignment="Top" />

        <StackPanel x:Name="Body" Margin="32,44,32,22">
            <ui:BitMascot x:Name="Mascot" Unit="3" HorizontalAlignment="Center"
                          Body="{DynamicResource Brush.Mascot}" Eye="{DynamicResource Brush.MascotEye}" />
            <TextBlock HorizontalAlignment="Center" Margin="0,16,0,0" FontFamily="{StaticResource Font.Display}" FontWeight="SemiBold" FontSize="22"
                       Foreground="{DynamicResource Brush.Text}"><Run Text="blox code" /><Run Text="_" Foreground="{DynamicResource Brush.Accent}" /></TextBlock>
            <TextBlock x:Name="VersionText" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" Margin="0,4,0,26" />

            <Button x:Name="LaunchButton" Style="{StaticResource Button.Primary}" HorizontalContentAlignment="Stretch" Padding="18,14" Click="OnLaunch" IsDefault="True">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE768;" Style="{StaticResource Text.Icon}" FontSize="16" Margin="0,0,14,0" />
                    <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" Style="{StaticResource Text.Icon}" FontSize="11" Opacity="0.7" />
                    <StackPanel>
                        <TextBlock Text="Launch Roblox" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="LaunchSummary" FontSize="12" FontWeight="Normal" Opacity="0.8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Button>

            <Button Style="{StaticResource Button.Secondary}" HorizontalContentAlignment="Stretch" Padding="18,14" Margin="0,10,0,0" Click="OnStudio">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE943;" Style="{StaticResource Text.Icon}" FontSize="16" Margin="0,0,14,0" />
                    <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" Style="{StaticResource Text.Icon}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                    <StackPanel>
                        <TextBlock Text="Launch Roblox Studio" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="StudioSummary" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Button>

            <Button Style="{StaticResource Button.Secondary}" HorizontalContentAlignment="Stretch" Padding="18,14" Margin="0,10,0,0" Click="OnConfigure">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE713;" Style="{StaticResource Text.Icon}" FontSize="16" Margin="0,0,14,0" />
                    <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" Style="{StaticResource Text.Icon}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                    <StackPanel>
                        <TextBlock Text="Configure Blox Code" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Fast Flags, mods, appearance and more" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Button>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                <Button Style="{StaticResource Button.Ghost}" FontSize="12.5" Padding="10,5" Content="What's new" Click="OnWhatsNew" />
                <Button x:Name="SourceButton" Style="{StaticResource Button.Ghost}" FontSize="12.5" Padding="10,5" Content="Source code" Click="OnSource" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
