<Window x:Class="BloxCode.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BloxCode.UI"
        Style="{StaticResource Window.Claude}"
        Title="Blox Code" Width="1040" Height="680" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterScreen" StateChanged="OnStateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" GlassFrameThickness="0,0,0,1" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Top bar: brand, page tabs, window buttons (the empty space drags the window) ===== -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="22,0,26,0" VerticalAlignment="Center">
                <ui:BitMascot x:Name="BrandMascot" Unit="1.2" VerticalAlignment="Center" Margin="0,0,10,0"
                              Body="{DynamicResource Brush.Mascot}" Eye="{DynamicResource Brush.MascotEye}" />
                <TextBlock FontFamily="{StaticResource Font.Mono}" FontWeight="Medium" FontSize="14" VerticalAlignment="Center"><Run Text="blox code" /><Run Text="_" Foreground="{DynamicResource Brush.Accent}" /></TextBlock>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource Button.Caption}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize" Height="40" />
                <Button x:Name="MaximizeButton" Style="{StaticResource Button.Caption}" Content="&#xE922;" Click="OnMaximize" ToolTip="Maximize" Height="40" />
                <Button Style="{StaticResource Button.CaptionClose}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close" Height="40" />
            </StackPanel>

            <StackPanel x:Name="Nav" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <RadioButton x:Name="NavHome" Style="{StaticResource Nav.Tab}" Tag="Home" Checked="OnNavigate" IsChecked="True" Content="Home" />
                <RadioButton Style="{StaticResource Nav.Tab}" Tag="FastFlags" Checked="OnNavigate" Content="Flags" />
                <RadioButton Style="{StaticResource Nav.Tab}" Tag="Mods" Checked="OnNavigate" Content="Mods" />
                <RadioButton Style="{StaticResource Nav.Tab}" Tag="Appearance" Checked="OnNavigate" Content="Look" />
                <RadioButton Style="{StaticResource Nav.Tab}" Tag="Behaviour" Checked="OnNavigate" Content="Settings" />
                <RadioButton Style="{StaticResource Nav.Tab}" Tag="About" Checked="OnNavigate" Content="About" />
            </StackPanel>
        </DockPanel>

        <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False" />

        <!-- ===== Status line: Roblox's state, then Blox Code's version ===== -->
        <DockPanel Grid.Row="2" Margin="24,8,24,12">
            <TextBlock x:Name="FooterVersion" DockPanel.Dock="Right" Style="{StaticResource Text.Mono}" FontSize="11.5" VerticalAlignment="Center" Margin="16,0,0,0" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Mint once Roblox is downloaded, amber before -->
                <Ellipse x:Name="FooterDot" Width="6" Height="6" Margin="0,0,9,0" VerticalAlignment="Center" Fill="{DynamicResource Brush.Success}" />
                <TextBlock x:Name="FooterTitle" Text="Roblox is up to date" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                <TextBlock x:Name="FooterSubtitle" Style="{StaticResource Text.Mono}" FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
