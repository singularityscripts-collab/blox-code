<Window x:Class="BloxCode.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BloxCode.UI"
        Style="{StaticResource Window.Claude}"
        Title="Blox Code" Width="1040" Height="680" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterScreen" StateChanged="OnStateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="0,0,0,1" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16,12,12">
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="32" Margin="8,0,0,0">
                    <ui:BitMascot x:Name="BrandMascot" Unit="1.4" VerticalAlignment="Center" Margin="0,0,10,0"
                                    Body="{DynamicResource Brush.Mascot}" Eye="{DynamicResource Brush.MascotEye}" />
                    <TextBlock FontFamily="{StaticResource Font.Mono}" FontWeight="Medium" FontSize="15" VerticalAlignment="Center"><Run Text="blox code" /><Run Text="_" Foreground="{DynamicResource Brush.Accent}" /></TextBlock>
                </StackPanel>

                <Button DockPanel.Dock="Top" Style="{StaticResource Button.Primary}" HorizontalContentAlignment="Center" Height="44" Padding="12,0" Margin="0,18,0,0" Click="OnPlay"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,9,0" />
                        <TextBlock Text="Play Roblox" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="14" />
                    </StackPanel>
                </Button>

                <!-- Footer: Roblox's state, then Blox Code's version -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Border Padding="12,10" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}" Background="{DynamicResource Brush.Surface}">
                        <DockPanel>
                            <!-- Mint once Roblox is downloaded, amber before -->
                            <Ellipse x:Name="FooterDot" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{DynamicResource Brush.Success}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="FooterTitle" Text="Roblox is up to date" FontSize="13" Foreground="{DynamicResource Brush.Text}" />
                                <TextBlock x:Name="FooterSubtitle" Style="{StaticResource Text.Mono}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="FooterVersion" Style="{StaticResource Text.Mono}" FontSize="11" Margin="6,10,0,0" />
                </StackPanel>

                <StackPanel Margin="0,20,0,0">
                    <RadioButton x:Name="NavHome" Style="{StaticResource Nav.Item}" Tag="Home" Checked="OnNavigate" IsChecked="True">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource Nav.Icon}" /><TextBlock Text="Home" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <TextBlock Text="CUSTOMIZE" Style="{StaticResource Text.Section}" />
                    <RadioButton Style="{StaticResource Nav.Item}" Tag="FastFlags" Checked="OnNavigate">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C1;" Style="{StaticResource Nav.Icon}" /><TextBlock Text="Fast Flags" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Nav.Item}" Tag="Mods" Checked="OnNavigate">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEA86;" Style="{StaticResource Nav.Icon}" /><TextBlock Text="Mods" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Nav.Item}" Tag="Appearance" Checked="OnNavigate">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" Style="{StaticResource Nav.Icon}" /><TextBlock Text="Appearance" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <TextBlock Text="APP" Style="{StaticResource Text.Section}" />
                    <RadioButton Style="{StaticResource Nav.Item}" Tag="Behaviour" Checked="OnNavigate">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource Nav.Icon}" /><TextBlock Text="Behaviour" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Nav.Item}" Tag="About" Checked="OnNavigate">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" Style="{StaticResource Nav.Icon}" /><TextBlock Text="About" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Main area ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource Button.Caption}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize" />
                <Button x:Name="MaximizeButton" Style="{StaticResource Button.Caption}" Content="&#xE922;" Click="OnMaximize" ToolTip="Maximize" />
                <Button Style="{StaticResource Button.CaptionClose}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close" />
            </StackPanel>

            <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False" />
        </Grid>
    </Grid>
</Window>
