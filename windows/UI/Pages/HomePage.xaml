<UserControl x:Class="BloxCode.UI.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:BloxCode.UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,8,40,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Install / default launcher banner: a mint-tinted strip with an icon tile -->
            <Border x:Name="Banner" Visibility="Collapsed" MaxWidth="640" Margin="0,0,0,24" Padding="16,12,12,12" CornerRadius="14" BorderThickness="1"
                    Background="{DynamicResource Brush.AccentSoft}" BorderBrush="{DynamicResource Brush.AccentLine}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="9" Margin="0,0,14,0" VerticalAlignment="Center" Background="{DynamicResource Brush.AccentLine}">
                        <TextBlock Text="&#xE71B;" Style="{StaticResource Text.Icon}" FontSize="15" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <CheckBox x:Name="DesktopShortcut" Style="{StaticResource Toggle}" IsChecked="True" Margin="0,0,8,0" ToolTip="Create a desktop shortcut" />
                        <TextBlock x:Name="DesktopShortcutLabel" Text="Desktop icon" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Button x:Name="BannerButton" Style="{StaticResource Button.Primary}" Padding="14,8" Click="OnBannerAction" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="BannerTitle" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock x:Name="BannerText" Style="{StaticResource Text.Muted}" FontSize="13" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1" MaxWidth="600" VerticalAlignment="Center" Margin="0,8,0,24">
                <!-- The game bar, like the Windows search box: paste a link and press Enter, or just Play -->
                <Border x:Name="Bar" Style="{StaticResource SearchBar}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE721;" Style="{StaticResource Text.Icon}" FontSize="15" Margin="0,0,13,0"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                        <Button x:Name="SendButton" DockPanel.Dock="Right" Style="{StaticResource Button.Send}" Width="44" Height="44"
                                Click="OnSend" ToolTip="Play" AutomationProperties.Name="Play">
                            <Button.Clip>
                                <EllipseGeometry Center="22,22" RadiusX="22" RadiusY="22" />
                            </Button.Clip>
                            <TextBlock Text="&#xE768;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="2,0,0,0" />
                        </Button>
                        <TextBox x:Name="Composer" Style="{StaticResource Input.Bare}" Tag="Paste a game link" FontSize="15" Margin="0,0,8,0"
                                 AutomationProperties.Name="Game link"
                                 KeyDown="OnComposerKeyDown" TextChanged="OnComposerChanged"
                                 GotKeyboardFocus="OnComposerFocus" LostKeyboardFocus="OnComposerFocus" />
                    </DockPanel>
                </Border>
                <TextBlock x:Name="ComposerHint" Style="{StaticResource Text.Mono}" HorizontalAlignment="Center" Margin="0,14,0,0"
                           Text="Enter to launch · empty opens Roblox" />

                <!-- Recent games and this week's play time -->
                <StackPanel x:Name="RecentSection" Visibility="Collapsed" Margin="0,48,0,0">
                    <DockPanel Margin="2,0,2,12">
                        <TextBlock x:Name="StatsText" DockPanel.Dock="Right" Style="{StaticResource Text.Mono}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock Text="recent" Style="{StaticResource Text.Mono}" VerticalAlignment="Center" />
                    </DockPanel>
                    <UniformGrid x:Name="RecentGames" Columns="4" Margin="-6,0" />
                </StackPanel>
            </StackPanel>

            <!-- Studio and repair, out of the way -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource Button.Ghost}" FontSize="12.5" Padding="12,7" Click="OnOpenStudio"
                        Foreground="{DynamicResource Brush.TextSecondary}" Content="Open Studio" />
                <Button Style="{StaticResource Button.Ghost}" FontSize="12.5" Padding="12,7" Click="OnReinstall"
                        Foreground="{DynamicResource Brush.TextSecondary}" Content="Reinstall Roblox" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
