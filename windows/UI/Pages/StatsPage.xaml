<UserControl x:Class="BloxCode.UI.Pages.StatsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" Margin="40,8,40,40">
            <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource Segmented}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="PeriodWeek" Style="{StaticResource Segment}" GroupName="StatsPeriod" Content="Week" IsChecked="True" Checked="OnPeriod" />
                        <RadioButton x:Name="PeriodMonth" Style="{StaticResource Segment}" GroupName="StatsPeriod" Content="Month" Checked="OnPeriod" />
                        <RadioButton x:Name="PeriodAll" Style="{StaticResource Segment}" GroupName="StatsPeriod" Content="All time" Checked="OnPeriod" />
                    </StackPanel>
                </Border>
                <TextBlock Text="Stats" Style="{StaticResource Text.H1}" />
            </DockPanel>
            <TextBlock x:Name="Intro" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />

            <!-- The four numbers -->
            <UniformGrid x:Name="Numbers" Columns="4" Margin="0,28,0,0" />

            <TextBlock x:Name="DaysTitle" Text="every day" Style="{StaticResource Text.Group}" />
            <Grid x:Name="DayChart" Height="120" Margin="0,12,0,0" />
            <DockPanel Margin="0,6,0,0">
                <TextBlock x:Name="ChartEnd" DockPanel.Dock="Right" Style="{StaticResource Text.Mono}" FontSize="11" />
                <TextBlock x:Name="ChartStart" Style="{StaticResource Text.Mono}" FontSize="11" />
            </DockPanel>

            <TextBlock Text="most played" Style="{StaticResource Text.Group}" />
            <StackPanel x:Name="TopGames" Margin="0,6,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
