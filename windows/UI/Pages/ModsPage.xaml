<UserControl x:Class="BloxCode.UI.Pages.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" Margin="40,18,40,40">
            <DockPanel>
                <Button x:Name="ResetAllButton" DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="Reset all" VerticalAlignment="Center" Click="OnResetAll" />
                <TextBlock Text="Mods" Style="{StaticResource Text.H1}" />
            </DockPanel>
            <TextBlock Style="{StaticResource Text.Muted}" FontSize="14" Margin="0,4,0,22"
                       Text="Swap Roblox's own files for yours: a ready-made preset, or a file you pick or drop onto its row. Mods are copied in on every launch, and Reset brings Roblox's original back." />

            <!-- The Mods folder, always one click away -->
            <Border Style="{StaticResource Card}" Padding="16,14">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="10" Margin="0,0,14,0" Background="{DynamicResource Brush.AccentSoft}">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Text.Icon}" FontSize="17" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" />
                    </Border>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" VerticalAlignment="Center" Click="OnOpenFolder">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,8,0" /><TextBlock Text="Open folder" /></StackPanel>
                    </Button>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Mods folder" Style="{StaticResource Text.H2}" />
                        <TextBlock x:Name="FolderPath" Style="{StaticResource Text.Mono}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Tabs: everything, one group, or just your files -->
            <Border Style="{StaticResource Segmented}" HorizontalAlignment="Left" Margin="0,10,0,0">
                <StackPanel x:Name="Tabs" Orientation="Horizontal" />
            </Border>

            <!-- Bloxstrap's ready-made presets (ModPresets), built in code -->
            <StackPanel x:Name="PresetsHost" />

            <!-- One card per group (Cursor, Sounds, Font), built from ModCatalog -->
            <StackPanel x:Name="Groups" />

            <!-- Everything in the Mods folder, including what the rows above put there -->
            <StackPanel x:Name="AdvancedCard">
                <DockPanel Margin="4,26,0,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" FontSize="12.5" Padding="10,4" Content="Refresh" Click="OnRefresh" />
                    <TextBlock Text="YOUR FILES" Style="{StaticResource Text.Section}" Margin="0" VerticalAlignment="Center" />
                    <TextBlock x:Name="CountText" Style="{StaticResource Text.Mono}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
                </DockPanel>
                <Border Style="{StaticResource Card}" Padding="20,14">
                    <StackPanel>
                        <!-- Empty state -->
                        <DockPanel x:Name="EmptyState">
                            <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="10" Margin="0,0,14,0" Background="{DynamicResource Brush.SurfaceAlt}">
                                <TextBlock Text="&#xE7B8;" Style="{StaticResource Text.Icon}" FontSize="16" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Nothing here yet" Style="{StaticResource Text.H2}" />
                                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,3,0,0"
                                           Text="Turn on a preset, pick a file above, or drop files into the Mods folder using Roblox's own paths: content\sounds\ouch.ogg replaces the death sound." />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl x:Name="ModList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="■" FontSize="9" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" Foreground="{DynamicResource Brush.TextSecondary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
