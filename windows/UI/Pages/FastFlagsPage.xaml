<UserControl x:Class="BloxCode.UI.Pages.FastFlagsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" Margin="40,8,40,40">
            <TextBlock Text="Fast Flags" Style="{StaticResource Text.H1}" />
            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,0,0,20"
                       Text="Engine switches written to ClientSettings\ClientAppSettings.json on every launch. Roblox only honours flags on its allow-list; the presets here use nothing else." />

            <!-- One-click graphics presets, built only from allow-listed flags -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Segmented}" VerticalAlignment="Center">
                            <StackPanel x:Name="GraphicsSegments" Orientation="Horizontal" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Graphics preset" Style="{StaticResource Text.H2}" />
                            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,2,0,0" Text="Quality, textures, grass and detail in one go." />
                        </StackPanel>
                    </DockPanel>
                    <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{StaticResource Radius.Medium}" Padding="12,9" Margin="0,14,0,0">
                        <TextBlock x:Name="GraphicsHint" Style="{StaticResource Text.Muted}" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </Border>

                    <!-- Suggestion from the graphics card -->
                    <Border x:Name="RecommendRow" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="{StaticResource Radius.Medium}" Padding="12,8" Margin="0,8,0,0" Visibility="Collapsed">
                        <DockPanel>
                            <Button x:Name="RecommendButton" DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Padding="12,5" Content="Use it" Click="OnUseRecommended" />
                            <TextBlock Text="&#xE945;" Style="{StaticResource Text.Icon}" FontSize="14" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0" />
                            <TextBlock x:Name="RecommendText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Brush.Text}" Margin="0,0,10,0" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Fast Flag editor entry, like Bloxstrap's "Fast Flag Editor" card -->
            <Button Style="{StaticResource Button.Base}" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                    Tag="{DynamicResource Brush.SurfaceAlt}" HorizontalContentAlignment="Stretch" Padding="20,16" Margin="0,0,0,14" Click="OnOpenEditor">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" Style="{StaticResource Text.Icon}" FontSize="13" Foreground="{DynamicResource Brush.TextMuted}" />
                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,14,0">
                        <TextBlock Text="&#xE70F;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="Fast Flag Editor" Style="{StaticResource Text.H2}" />
                        <TextBlock x:Name="EditorSummary" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Button>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Presets" Style="{StaticResource Text.H2}" Margin="0,0,0,12" />

                    <DockPanel Margin="0,4">
                        <CheckBox x:Name="ExclusiveFullscreen" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="OnPresetChanged" />
                        <StackPanel>
                            <TextBlock Text="Exclusive fullscreen" />
                            <TextBlock Style="{StaticResource Text.Muted}" Text="Alt+Enter switches to true exclusive fullscreen instead of a borderless window." />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />

                    <DockPanel Margin="0,4">
                        <CheckBox x:Name="DisableScaling" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="OnPresetChanged" />
                        <StackPanel>
                            <TextBlock Text="Disable DPI scaling" />
                            <TextBlock Style="{StaticResource Text.Muted}" Text="Render at native resolution on high-DPI displays (sharper, smaller UI)." />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />

                    <DockPanel Margin="0,4">
                        <CheckBox x:Name="PauseLighting" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="OnPresetChanged" />
                        <StackPanel>
                            <TextBlock Text="Pause lighting updates" />
                            <TextBlock Style="{StaticResource Text.Muted}" Text="More FPS on weak graphics cards. Light and shadows from moving things stop updating." />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />

                    <DockPanel Margin="0,4">
                        <CheckBox x:Name="PlainSky" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="OnPresetChanged" />
                        <StackPanel>
                            <TextBlock Text="Plain gray sky" />
                            <TextBlock Style="{StaticResource Text.Muted}" Text="Skips drawing the skybox for a few extra frames." />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />

                    <DockPanel Margin="0,4">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Segmented}" VerticalAlignment="Center">
                            <StackPanel x:Name="RendererSegments" Orientation="Horizontal" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Rendering API" />
                            <TextBlock Style="{StaticResource Text.Muted}" Text="Ask Roblox for Direct3D 11, Vulkan or OpenGL." />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />

                    <DockPanel Margin="0,4">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Segmented}" VerticalAlignment="Center">
                            <StackPanel x:Name="MsaaSegments" Orientation="Horizontal" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Anti-aliasing (MSAA)" />
                            <TextBlock Style="{StaticResource Text.Muted}" Text="Force a sample count." />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />

                    <DockPanel Margin="0,4">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Segmented}" VerticalAlignment="Center">
                            <StackPanel x:Name="TextureSegments" Orientation="Horizontal" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Texture quality" />
                            <TextBlock Style="{StaticResource Text.Muted}" Text="Override Roblox's automatic choice." />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
