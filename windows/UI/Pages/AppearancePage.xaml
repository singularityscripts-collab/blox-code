<UserControl x:Class="BloxCode.UI.Pages.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:BloxCode.UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" Margin="40,8,40,40">
            <TextBlock Text="Look" Style="{StaticResource Text.H1}" />
            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,0,0,20" Text="Theme, colour and motion." />

            <TextBlock Text="theme" Style="{StaticResource Text.Group}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,4">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Segmented}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ThemeSystem" Style="{StaticResource Segment}" GroupName="Theme" Content="System" Checked="OnThemeChanged" />
                                <RadioButton x:Name="ThemeLight" Style="{StaticResource Segment}" GroupName="Theme" Content="Light" Checked="OnThemeChanged" />
                                <RadioButton x:Name="ThemeDark" Style="{StaticResource Segment}" GroupName="Theme" Content="Dark" Checked="OnThemeChanged" />
                            </StackPanel>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Theme" />
                            <TextBlock Style="{StaticResource Text.Muted}" Text="System follows Windows' app mode." />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel Margin="0,4">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Segmented}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="BackdropOff" Style="{StaticResource Segment}" GroupName="Backdrop" Content="Off" Checked="OnBackdropChanged" />
                                <RadioButton x:Name="BackdropMica" Style="{StaticResource Segment}" GroupName="Backdrop" Content="Mica" Checked="OnBackdropChanged" />
                                <RadioButton x:Name="BackdropAcrylic" Style="{StaticResource Segment}" GroupName="Backdrop" Content="Acrylic" Checked="OnBackdropChanged" />
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Transparency" />
                            <TextBlock x:Name="BackdropText" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel Margin="0,4">
                        <StackPanel x:Name="AccentSwatches" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Accent colour" />
                            <TextBlock Style="{StaticResource Text.Muted}" Text="Buttons, toggles and the launch window's progress bar." />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel Margin="0,4">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ResetIconButton" Style="{StaticResource Button.Ghost}" Content="Use Bit" Margin="0,0,6,0" Click="OnResetIcon" />
                            <Button Style="{StaticResource Button.Secondary}" Content="Choose .ico…" Click="OnChooseIcon" />
                        </StackPanel>
                        <Image x:Name="IconPreview" DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Shortcut icon" />
                            <TextBlock x:Name="IconText" Style="{StaticResource Text.Muted}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel Margin="0,4">
                        <CheckBox x:Name="Animate" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="OnAnimateChanged" />
                        <StackPanel>
                            <TextBlock Text="Animate Bit" />
                            <TextBlock Style="{StaticResource Text.Muted}" Text="Walking, blinking and the little victory hop. Turn off for a calmer screen." />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel Margin="0,4">
                        <CheckBox x:Name="Animations" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="OnAnimationsChanged" />
                        <StackPanel>
                            <TextBlock Text="Interface animations" />
                            <TextBlock Style="{StaticResource Text.Muted}" Text="Pages slide in and cards follow one after another. Also off when Windows' animation effects are off." />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Preview launch screen" VerticalAlignment="Center" Click="OnPreview" />
                        <ui:BitMascot x:Name="Mascot" DockPanel.Dock="Left" Unit="3" Mood="Walk" Margin="0,0,20,0" VerticalAlignment="Center"
                                        Body="{DynamicResource Brush.Mascot}" Eye="{DynamicResource Brush.MascotEye}" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Launch screen" Style="{StaticResource Text.H2}" />
                            <TextBlock x:Name="LaunchThemeText" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Segmented}" Margin="0,14,0,0">
                        <StackPanel x:Name="LaunchThemeSegments" Orientation="Horizontal" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
