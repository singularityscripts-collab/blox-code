<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Blox Code "Daylight": near-white paper, graphite text, deep mint accent. Flat surfaces and
         hairline borders, like the dark theme. Bit keeps its clay. -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#FAFAFA" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#FAFAFA" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#F3F3F5" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#EFEFF1" />
    <SolidColorBrush x:Key="Brush.Selected" Color="#E6E6E9" />
    <SolidColorBrush x:Key="Brush.NavSelected" Color="#EDEDF0" />
    <SolidColorBrush x:Key="Brush.Border" Color="#E7E7EA" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#D5D5DA" />
    <SolidColorBrush x:Key="Brush.Text" Color="#18181B" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#3F3F46" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#71717A" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#077257" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#055C46" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#E2F3ED" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#C53A46" />
    <SolidColorBrush x:Key="Brush.Success" Color="#2F7D4F" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#9A6A12" />
    <SolidColorBrush x:Key="Brush.Mascot" Color="#D77757" />
    <SolidColorBrush x:Key="Brush.MascotEye" Color="#141413" />
    <Color x:Key="Color.Shadow">#22000000</Color>

    <SolidColorBrush x:Key="Brush.CardFill" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#E7E7EA" />
    <SolidColorBrush x:Key="Brush.AccentFill" Color="#077257" />
    <SolidColorBrush x:Key="Brush.Glow" Color="Transparent" />
</ResourceDictionary>
