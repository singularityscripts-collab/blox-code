<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Blox Code "Midnight terminal": near-black ground, a slightly lifted sidebar and cards,
         hairline borders and one mint accent, with JetBrains Mono for titles and labels. -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#0E0F11" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#121316" />
    <!-- Sunken track behind segmented choices -->
    <SolidColorBrush x:Key="Brush.Well" Color="#0E0F11" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#16171A" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#1F2126" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#1A1B1F" />
    <SolidColorBrush x:Key="Brush.Selected" Color="#2B2D33" />
    <SolidColorBrush x:Key="Brush.NavSelected" Color="#1F2126" />
    <SolidColorBrush x:Key="Brush.Border" Color="#1F2125" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#2A2C31" />
    <SolidColorBrush x:Key="Brush.Text" Color="#ECEDEE" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A3A6AD" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#868A93" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#4ADE9A" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#6BE8AF" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#14251D" />
    <SolidColorBrush x:Key="Brush.AccentLine" Color="#1F4433" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#05261A" />
    <SolidColorBrush x:Key="Brush.ToggleOff" Color="#2A2C32" />
    <SolidColorBrush x:Key="Brush.Knob" Color="#9A9DA4" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FCA5A5" />
    <SolidColorBrush x:Key="Brush.Success" Color="#4ADE9A" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#F2C14E" />
    <SolidColorBrush x:Key="Brush.Mascot" Color="#D77757" />
    <SolidColorBrush x:Key="Brush.MascotEye" Color="#141413" />
    <Color x:Key="Color.Shadow">#99000000</Color>

    <SolidColorBrush x:Key="Brush.CardFill" Color="#16171A" />
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#222429" />
    <SolidColorBrush x:Key="Brush.AccentFill" Color="#4ADE9A" />
    <SolidColorBrush x:Key="Brush.Glow" Color="Transparent" />
</ResourceDictionary>
