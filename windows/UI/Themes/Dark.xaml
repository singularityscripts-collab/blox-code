<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Blox Code "Midnight": deep navy like Bit's terminal screen, with a bright mint cursor accent. -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#0F131D" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#0A0D15" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#181D2B" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#131826" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#212839" />
    <SolidColorBrush x:Key="Brush.Selected" Color="#283149" />
    <SolidColorBrush x:Key="Brush.NavSelected" Color="#16282C" />
    <SolidColorBrush x:Key="Brush.Border" Color="#232A3C" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#343D55" />
    <SolidColorBrush x:Key="Brush.Text" Color="#ECF0FA" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#C3CADB" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#8A93AB" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#3EE6B0" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#6CEFC5" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#133A35" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#052A20" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FF7A85" />
    <SolidColorBrush x:Key="Brush.Success" Color="#5FD99A" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#F2C14E" />
    <SolidColorBrush x:Key="Brush.Mascot" Color="#D77757" />
    <SolidColorBrush x:Key="Brush.MascotEye" Color="#141413" />
    <Color x:Key="Color.Shadow">#80000000</Color>

    <!-- Depth: cards catch light at the top edge, the primary button is a slight gradient, and a
         faint mint glow sits behind the page. -->
    <LinearGradientBrush x:Key="Brush.CardFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1B2131" Offset="0" />
        <GradientStop Color="#161B28" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.CardBorder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#36405A" Offset="0" />
        <GradientStop Color="#1F2535" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.AccentFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#55F0C2" Offset="0" />
        <GradientStop Color="#2CD39F" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="Brush.Glow" Center="0.85,0" GradientOrigin="0.85,0" RadiusX="0.75" RadiusY="0.9">
        <GradientStop Color="#223EE6B0" Offset="0" />
        <GradientStop Color="#0C6C7CFF" Offset="0.45" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>
</ResourceDictionary>
