<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Blox Code "Midnight": quiet neutral charcoal with one mint accent. Flat surfaces, hairline
         borders, no glow; depth comes from a single step between background and surface. -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#111214" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#111214" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#18191C" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#1C1D21" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#202125" />
    <SolidColorBrush x:Key="Brush.Selected" Color="#27282D" />
    <SolidColorBrush x:Key="Brush.NavSelected" Color="#1E1F23" />
    <SolidColorBrush x:Key="Brush.Border" Color="#24252A" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#313238" />
    <SolidColorBrush x:Key="Brush.Text" Color="#EDEEF0" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#B6B9C0" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#7D818B" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#3EE6B0" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#62EDC1" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#14302A" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#04261C" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FF7A85" />
    <SolidColorBrush x:Key="Brush.Success" Color="#5FD99A" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#F2C14E" />
    <SolidColorBrush x:Key="Brush.Mascot" Color="#D77757" />
    <SolidColorBrush x:Key="Brush.MascotEye" Color="#141413" />
    <Color x:Key="Color.Shadow">#66000000</Color>

    <SolidColorBrush x:Key="Brush.CardFill" Color="#16171A" />
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#24252A" />
    <SolidColorBrush x:Key="Brush.AccentFill" Color="#3EE6B0" />
    <SolidColorBrush x:Key="Brush.Glow" Color="Transparent" />
</ResourceDictionary>
